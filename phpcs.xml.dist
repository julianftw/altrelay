<?xml version="1.0"?>
<ruleset name="AltRelay Coding Standards">
	<description>PHP_CodeSniffer ruleset for AltRelay.</description>

	<!-- Scan these files -->
	<file>.</file>

	<!-- Exclude vendor and tests from WP standards (tests have their own rules) -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>
	<exclude-pattern>/phpstan-bootstrap.php</exclude-pattern>

	<!-- Show sniff codes in all reports -->
	<arg value="ps"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<!-- Use WordPress Coding Standards -->
	<rule ref="WordPress">
		<!-- Allow short array syntax -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
	</rule>

	<!-- Check for PHP cross-version compatibility (PHP 8.2+) -->
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="8.2-"/>

	<!-- Set minimum WP version for deprecated function sniffs -->
	<config name="minimum_wp_version" value="6.7"/>

	<!-- Text domain for i18n -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="altrelay"/>
			</property>
		</properties>
	</rule>

	<!-- Prefixes for naming conventions -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="altrelay"/>
				<element value="AltRelay"/>
			</property>
		</properties>
	</rule>
</ruleset>
